{
  "name": "oneboss-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:config": "tsx --env-file-if-exists=.env.local scripts/check-config.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "smoke:mimo": "tsx --env-file-if-exists=.env.local scripts/smoke-mimo.ts",
    "smoke:public": "tsx --env-file-if-exists=.env.local scripts/smoke-public.ts",
    "db:bootstrap:generate": "tsx scripts/generate-supabase-bootstrap.ts",
    "start:service": "node --env-file-if-exists=.env.local scripts/start-service.mjs",
    "acceptance:a": "tsx --env-file-if-exists=.env.local scripts/acceptance-a.ts",
    "acceptance:b": "tsx --env-file-if-exists=.env.local scripts/acceptance-b.ts",
    "acceptance:hosted": "tsx --env-file-if-exists=.env.local scripts/acceptance-hosted.ts",
    "acceptance:hosted:write": "tsx --env-file-if-exists=.env.local scripts/acceptance-hosted-write.ts",
    "acceptance:customer:ui": "tsx --env-file-if-exists=.env.local scripts/acceptance-customer-ui.ts",
    "check:wechat": "tsx --env-file-if-exists=.env.local scripts/check-wechat.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "0.468.0",
    "next": "16.4.5",
    "playwright-core": "1.65.0",
    "postcss": "^8.5.32",
    "postgres": "^3.4.7",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.4",
    "undici": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
