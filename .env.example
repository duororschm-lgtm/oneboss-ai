# Copy to .env.local; never commit real values. Pooled/direct PostgreSQL URL is server-only.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIMO_API_KEY=
MIMO_MODEL=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
APP_URL=
# sandbox is rejected when NODE_ENV=production unless explicitly enabled for demo orders.
ALLOW_SANDBOX=false
STORAGE_BUCKET=oneboss-private
# Set to B's server-only integration adapter module, exporting the documented functions.
CREATIVE_ADAPTER_MODULE=
