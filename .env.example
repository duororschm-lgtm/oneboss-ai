# Copy to .env.local; never commit real values. Pooled/direct PostgreSQL URL is server-only.
# Copy the Session pooler URI, retaining [YOUR-PASSWORD] when using the separate field below.
DATABASE_URL=
# Optional raw database password; avoids manual URL encoding. Never a Supabase API key.
DATABASE_PASSWORD=
# Optional provider CA certificate (PEM); verification stays enabled.
DATABASE_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIMO_API_KEY=
MIMO_MODEL=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Public HTTPS origin, no path/query (e.g. https://app.example.com).
# Must be https + real hostname: appOrigin() rejects http, IP, localhost, *.local,
# because poster QR codes and browser acceptance are generated from this value.
APP_URL=
# sandbox is rejected when NODE_ENV=production unless explicitly enabled for demo orders.
ALLOW_SANDBOX=false
STORAGE_BUCKET=oneboss-private
# Use builtin:b for the included B renderer, or an absolute server-only JS module path.
CREATIVE_ADAPTER_MODULE=
# Enable email password recovery after SMTP delivery is verified; username signup is independent.
CUSTOMER_EMAIL_READY=false
# Enables the owner-provided WeChat collection image and platform-reviewed receipt workflow.
MANUAL_PAYMENT_ENABLED=false
# Alipay manual review requires the owner-provided public/payments/alipay-receive.png.
ALIPAY_MANUAL_PAYMENT_ENABLED=false
ALIPAY_PAYEE_DISPLAY_NAME=
# WeChat Pay APIv3 Native; leave disabled until the merchant configuration is verified.
WECHAT_PAY_ENABLED=false
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=.secrets/wechat/apiclient_key.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=.secrets/wechat/wechatpay_public_key.pem
WECHAT_API_V3_KEY=
# Render may use multiline WECHAT_PRIVATE_KEY / WECHAT_PUBLIC_KEY instead of local file paths.
